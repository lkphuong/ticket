{
  "name": "vtdesk",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "api"
  ],
  "scripts": {
    "dev:web": "bun --filter ./web dev",
    "dev:api": "bun --filter @vtdesk/api dev",
    "db:migrate": "bun --filter @vtdesk/api db:migrate",
    "db:seed": "bun --filter @vtdesk/api db:seed",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "lint": "oxlint web/src packages/domain/src api/src",
    "db:drop": "bun --filter @vtdesk/api db:drop"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2"
  }
}
