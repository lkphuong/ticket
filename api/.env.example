PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=ticket
# Directory where uploaded ticket attachments are stored; mount a persistent volume here in production
UPLOAD_DIR=./uploads
# Initial password of the admin account created by `bun run db:seed -- --admin-only` (at least 8 characters)
ADMIN_INITIAL_PASSWORD=

# Required in production (the API refuses to start without them); optional in development
# Resend API key used to deliver verification emails
RESEND_API_KEY=
# Sender address registered with Resend, for example "VTDesk <no-reply@your-domain.com>"
RESEND_FROM_EMAIL=
# Secret (at least 32 random characters) used to HMAC-hash OTP codes before storage
OTP_HMAC_SECRET=

# Firebase Cloud Messaging (push notifications); leave empty to disable push delivery
# Values come from the Firebase service account JSON (project_id, client_email, private_key with newlines escaped as \n)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
