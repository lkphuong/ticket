  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.89.0",
    "supertest": "^7.0.0",
    "typescript": "~7.0.2"
