# Used by docker compose; copy to .env and fill in. Compose reads this file automatically.
NODE_ENV=production
WEB_PORT=8181

# MongoDB is not bundled; point this at an existing instance reachable from the taco-bridge network
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=ticket

# Required in production: the API refuses to start without them
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_HMAC_SECRET=

# Initial password of the admin account (at least 8 characters)
ADMIN_INITIAL_PASSWORD=

# Firebase Admin credentials for push delivery; leave empty to disable push
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web configuration, baked into the client at build time
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
